---
import { siteHref } from '../utils/urls';
import CallLink from './CallLink.astro';
import { salon } from '../data/salon';
const isCatalog = Astro.url.pathname === siteHref('/uslugi/');
---
<header class="site-header">
  <div class="topline">
    <div class="container topline-inner"><span>{salon.address}</span><span>{salon.hours}</span></div>
  </div>
  <div class="container header-inner">
    <a class="brand" href={siteHref('/')} aria-label="Юлия Дубицкая — главная">
      <span class="brand-name">Юлия Дубицкая</span>
      <span class="brand-description">Салон красоты</span>
    </a>
    <nav aria-label="Основная навигация">
      <a href={siteHref('/#about')}>О салоне</a>
      <a href={siteHref('/uslugi/')} aria-current={isCatalog ? 'page' : undefined}>Услуги и цены</a>
      <a href={siteHref('/aktsii/')} aria-current={Astro.url.pathname === siteHref('/aktsii/') ? 'page' : undefined}>Акции</a>
      <a href={siteHref('/#contacts')}>Контакты</a>
    </nav>
    <CallLink label={salon.phone} class="header-phone" />
  </div>
</header>
