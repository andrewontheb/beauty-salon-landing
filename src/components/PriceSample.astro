---
import { siteHref } from '../utils/urls';
import { priceSamples, directionHref } from '../data/catalog';
import PriceVariants from './PriceVariants.astro';
---
<section class="section price-preview" aria-labelledby="price-preview-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="price-preview-title">Из прайса салона</h2>
      <a class="text-link" href={siteHref('/uslugi/')}>Все услуги и цены</a>
    </div>
    <div class="sample-list">
      {priceSamples.map(({ direction, groupId, service }) => (
        <article class="sample-item" data-service={`${direction.id}/${groupId}/${service.id}`}>
          <h3><a href={`${directionHref(direction)}#service-${groupId}-${service.id}`}>{service.title}</a></h3>
          <PriceVariants service={service} path={`${direction.id}/${groupId}/${service.id}`} />
          <a class="text-link" href={directionHref(direction)}>{direction.title}</a>
        </article>
      ))}
    </div>
  </div>
</section>
