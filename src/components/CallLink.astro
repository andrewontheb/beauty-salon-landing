---
import { salon } from '../data/salon';
interface Props { label?: string; class?: string; }
const { label = 'Позвонить для записи', class: className = 'button button-primary' } = Astro.props;
---
<a href={salon.phoneHref} class={className}>
  <svg class="phone-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7.2 3H4.7C3.8 3 3 3.8 3 4.7 3 13.7 10.3 21 19.3 21c.9 0 1.7-.8 1.7-1.7v-2.5l-4.3-2-1.8 1.8a14 14 0 0 1-7.5-7.5l1.8-1.8L7.2 3Z" stroke-linejoin="round"/></svg>
  <span>{label}</span>
</a>
