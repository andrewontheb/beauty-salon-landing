---
import { Image } from 'astro:assets';
import haircut from '../assets/gallery/haircut.jpg';
import interior from '../assets/gallery/interior-stock.jpg';
import wash from '../assets/gallery/hair-wash.jpg';
import styling from '../assets/gallery/styling.jpg';
import care from '../assets/gallery/hair-care.jpg';
// Предоставленные стоковые превью; не фотографии салона или его работ.
const photos = [
  { src: interior, title: 'Интерьер салона' },
  { src: haircut, title: 'Мужская стрижка' },
  { src: wash, title: 'Мытьё волос' },
  { src: styling, title: 'Укладка волос' },
  { src: care, title: 'Уход за волосами' },
];
---
<salon-gallery id="gallery" class="container gallery" role="region" aria-roledescription="карусель" aria-label="Фотографии">
  <button class="gallery-control gallery-pause" type="button" data-rotation aria-label="Остановить автопрокрутку" aria-controls="gallery-track" hidden>
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path class="pause-symbol" d="M7 4v12M13 4v12" /><path class="play-symbol" d="m6 3 10 7-10 7V3Z" />
    </svg>
  </button>
  <button class="gallery-control gallery-previous" type="button" data-step="-1" aria-label="Предыдущее фото" aria-controls="gallery-track" hidden>
    <svg width="18" height="26" viewBox="0 0 18 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m13 4-9 9 9 9" /></svg>
  </button>
  <div class="gallery-viewport">
    <div id="gallery-track" class="gallery-track" role="group" tabindex="0" aria-label="Фотографии: используйте стрелки влево и вправо">
      {photos.map((photo, index) => <figure class="gallery-slide" role="group" aria-roledescription="слайд" aria-label={`${index + 1} из ${photos.length}`}>
        <Image src={photo.src} alt={`Тематическое фото: ${photo.title.toLowerCase()}`} width={640} height={427} widths={[320, 640, 960]} sizes="(max-width: 600px) calc(100vw - 96px), calc(50vw - 120px)" format="webp" loading="lazy" />
      </figure>)}
    </div>
  </div>
  <button class="gallery-control gallery-next" type="button" data-step="1" aria-label="Следующее фото" aria-controls="gallery-track" hidden>
    <svg width="18" height="26" viewBox="0 0 18 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 4 9 9-9 9" /></svg>
  </button>
  <p class="visually-hidden" data-gallery-status aria-live="off" aria-atomic="true"></p>
</salon-gallery>
<script>
  class SalonGallery extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.gallery-track')!;
      const viewport = this.querySelector<HTMLElement>('.gallery-viewport')!;
      const slides = [...track.querySelectorAll<HTMLElement>('.gallery-slide')];
      const rotation = this.querySelector<HTMLButtonElement>('[data-rotation]')!;
      const status = this.querySelector<HTMLElement>('[data-gallery-status]')!;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const mobile = matchMedia('(max-width: 600px)');
      const events = new AbortController();
      const options = { signal: events.signal };
      let index = 2;
      let pending = 0;
      let moving = false;
      let paused = motion.matches;
      let hovered = false;
      let visible = false;
      let preparing = false;
      let ready = false;
      let drag: { x: number; y: number; dx: number } | null = null;
      let rotationWasPaused: boolean | undefined;
      let timer: ReturnType<typeof setInterval> | undefined;
      let transitionTimer: ReturnType<typeof setTimeout> | undefined;

      const clone = (slide: HTMLElement) => {
        const copy = slide.cloneNode(true) as HTMLElement;
        copy.dataset.clone = '';
        copy.setAttribute('aria-hidden', 'true');
        copy.inert = true;
        copy.querySelector('img')!.alt = '';
        return copy;
      };
      track.prepend(...slides.slice(-2).map(clone));
      track.append(...slides.slice(0, 2).map(clone));
      const step = () => track.children[1].getBoundingClientRect().left - track.children[0].getBoundingClientRect().left;
      const logical = () => (index - 2 + slides.length) % slides.length;
      const draw = (offset = 0) => { track.style.transform = `translateX(${-index * step() + offset}px)`; };
      const announce = () => {
        const current = logical();
        slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== current && (mobile.matches || i !== (current + 1) % slides.length))));
        status.textContent = `Фото ${current + 1} из ${slides.length}`;
        this.dataset.slide = String(current);
      };
      const autoplay = () => {
        clearInterval(timer);
        const running = ready && !paused && !hovered && !motion.matches && visible && !document.hidden;
        rotation.disabled = !ready || motion.matches;
        rotation.setAttribute('aria-label', motion.matches ? 'Автопрокрутка отключена: уменьшение движения' : paused ? 'Включить автопрокрутку' : 'Остановить автопрокрутку');
        rotation.dataset.paused = String(paused || motion.matches);
        status.setAttribute('aria-live', running ? 'off' : 'polite');
        this.dataset.playing = String(running);
        if (running) timer = setInterval(() => { if (!moving && !drag) move(1); }, 5000);
      };
      const stop = () => { paused = true; autoplay(); };
      const finish = () => {
        clearTimeout(transitionTimer);
        moving = false;
        index = logical() + 2;
        track.style.transition = 'none';
        draw();
        // Фиксируем незаметную замену клонов оригиналами до следующего перехода.
        track.getBoundingClientRect();
        track.style.transition = '';
        announce();
        if (pending) {
          const direction = Math.sign(pending);
          pending -= direction;
          move(direction);
        }
      };
      const move = (direction: number) => {
        if (moving) { pending += direction; return; }
        index += direction;
        moving = true;
        draw();
        if (motion.matches) finish();
        else transitionTimer = setTimeout(finish, 520);
      };
      this.dataset.enhanced = '';
      track.scrollLeft = 0;
      track.style.transition = 'none';
      draw();
      track.getBoundingClientRect();
      track.style.transition = '';
      announce();
      this.querySelectorAll<HTMLButtonElement>('.gallery-control').forEach((button) => { button.hidden = false; button.disabled = true; });
      track.addEventListener('transitionend', (event) => {
        if (event.target === track && event.propertyName === 'transform' && moving) finish();
      }, options);
      this.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
        button.addEventListener('click', () => { stop(); move(Number(button.dataset.step)); }, options);
      });
      track.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        stop();
        if (event.key === 'Home' || event.key === 'End') {
          pending = 0;
          index = event.key === 'Home' ? 2 : slides.length + 1;
          finish();
        } else move(event.key === 'ArrowRight' ? 1 : -1);
      }, options);
      this.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') { hovered = true; autoplay(); } }, options);
      this.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') { hovered = false; autoplay(); } }, options);
      this.addEventListener('focusin', stop, options);
      rotation.addEventListener('pointerdown', () => { rotationWasPaused = paused; }, options);
      rotation.addEventListener('keydown', () => { rotationWasPaused = undefined; }, options);
      rotation.addEventListener('pointercancel', () => { rotationWasPaused = undefined; }, options);
      rotation.addEventListener('click', () => {
        paused = !(rotationWasPaused ?? paused);
        rotationWasPaused = undefined;
        autoplay();
      }, options);
      viewport.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        stop();
        if (moving) return;
        drag = { x: event.clientX, y: event.clientY, dx: 0 };
        viewport.setPointerCapture(event.pointerId);
        track.style.transition = 'none';
      }, options);
      viewport.addEventListener('pointermove', (event) => {
        if (!drag) return;
        drag.dx = event.clientX - drag.x;
        if (Math.abs(drag.dx) > Math.abs(event.clientY - drag.y)) draw(Math.max(-step(), Math.min(step(), drag.dx)));
      }, options);
      const endDrag = (event: PointerEvent) => {
        if (!drag) return;
        const dx = drag.dx;
        drag = null;
        track.style.transition = '';
        move(event.type !== 'pointercancel' && Math.abs(dx) > 45 ? dx < 0 ? 1 : -1 : 0);
      };
      viewport.addEventListener('pointerup', endDrag, options);
      viewport.addEventListener('pointercancel', endDrag, options);
      viewport.addEventListener('dragstart', (event) => event.preventDefault(), options);
      motion.addEventListener('change', () => { pending = 0; finish(); stop(); }, options);
      document.addEventListener('visibilitychange', autoplay, options);
      const resize = new ResizeObserver(() => { pending = 0; drag = null; finish(); });
      resize.observe(viewport);
      const visibility = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !preparing) {
          preparing = true;
          const images = [...track.querySelectorAll('img')];
          images.forEach((image) => { image.loading = 'eager'; });
          Promise.all(images.map((image) => image.decode())).then(() => {
            if (events.signal.aborted) return;
            ready = true;
            this.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => { button.disabled = false; });
            autoplay();
          }).catch(stop);
        }
        autoplay();
      });
      visibility.observe(this);
      autoplay();
      this.cleanup = () => {
        events.abort(); clearInterval(timer); clearTimeout(transitionTimer);
        resize.disconnect(); visibility.disconnect();
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('salon-gallery', SalonGallery);
</script>
