---
import { publicCatalog, directionHref } from '../data/catalog';
import { Image } from 'astro:assets';
import { directionImages } from '../data/direction-images';
interface Props { illustrated?: boolean; }
const { illustrated = false } = Astro.props;
---
<div class:list={['direction-list', { 'direction-list-illustrated': illustrated }]}>
  {publicCatalog.map((direction) => (
    <a class="direction-link" href={directionHref(direction)}>
      {illustrated && <Image src={directionImages[direction.id]} alt="" width={144} height={108} widths={[144, 288]} sizes="(max-width: 600px) 88px, 144px" format="webp" loading="lazy" class="direction-thumbnail" />}
      <span><span class="direction-title">{direction.title}</span><span class="direction-summary">{direction.summary}</span></span>
      <span class="direction-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>
{illustrated && <p class="image-disclosure">Изображения направлений — AI-иллюстрации, не фотографии работ салона.</p>}
