    <path d="m35 5 2 6 6 2-6 2-2 6-2-6-6-2 6-2 2-6Z" />
  </>}
  {id === 'face-antistress' && <>
    <path d="M24 32C12 27 11 16 24 7c13 9 12 20 0 25ZM24 32C10 34 5 26 6 18c8 0 14 4 18 14ZM24 32c14 2 19-6 18-14-8 0-14 4-18 14ZM12 37c7 6 17 6 24 0" />
