---
import { siteHref } from '../utils/urls';
import Layout from '../layouts/Layout.astro';
import CallLink from '../components/CallLink.astro';
---
<Layout title="Страница не найдена — салон Юлия Дубицкая" description="Эта страница не найдена. Перейдите к услугам и ценам салона «Юлия Дубицкая» или позвоните для записи.">
  <section class="container not-found">
    <p class="muted">Ошибка 404</p>
    <h1>Страница не найдена</h1>
    <p>Возможно, адрес изменился. Нужную услугу можно найти в каталоге.</p>
    <div><a class="button button-primary" href={siteHref('/uslugi/')}>Услуги и цены</a><CallLink class="text-link" /></div>
    <a class="text-link" href={siteHref('/')}>На главную</a>
  </section>
</Layout>
